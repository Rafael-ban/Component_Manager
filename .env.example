# Copy to .env beside docker-compose.yml and edit before deployment.
# Android, Windows and the web login use this same token (not a GitHub token).
API_TOKEN=change-me
# Replace/add the actual web page origin, including its scheme and port.
ADMIN_WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# Optional public API URL. Empty uses the web page host with API port 8787.
VITE_DEFAULT_API_BASE_URL=
# Allow authenticated inventory writes from the web console. Disabled by default.
WEB_INVENTORY_ENABLED=false
# For docker-compose.hub.yml only: set your published Docker Hub image and tag.
COMPONENT_VAULT_IMAGE=rafaelikaros/component_manager:0.7.0
# Optional web profile image. The compose file uses this default when omitted.
COMPONENT_VAULT_WEB_IMAGE=rafaelikaros/component_manager:web-0.7.0
