<Window
    x:Class="ComponentVault.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ComponentVault.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="元件仓库"
    mc:Ignorable="d">

    <Grid Background="{StaticResource VaultBackgroundBrush}">
        <NavigationView
            x:Name="AppNavigationView"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.Header>
                <Grid Margin="0,6,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="元件仓库" />
                        <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="WinUI 3 原生桌面客户端" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="OnSyncNowClicked"
                        Content="立即同步" />
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DashboardItem" Content="概览" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="元器件" Tag="Components">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="出入库" Tag="Movements">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sort" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="同步设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
