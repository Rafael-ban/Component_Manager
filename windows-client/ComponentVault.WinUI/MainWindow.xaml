<Window
    x:Class="ComponentVault.WinUI.MainWindow"
    x:Uid="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="元件仓库"
    mc:Ignorable="d">

    <Grid Background="{StaticResource VaultBackgroundBrush}">
        <NavigationView
            x:Name="AppNavigationView"
            IsBackButtonVisible="Collapsed"
            IsBackEnabled="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="OnSelectionChanged">
            <NavigationView.Header>
                <Grid Margin="0,4,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="2">
                        <TextBlock
                            x:Uid="MainWindowHeaderTitle"
                            FontSize="24"
                            FontWeight="SemiBold"
                            Text="库存工作台" />
                        <TextBlock
                            x:Uid="MainWindowHeaderSubtitle"
                            Style="{StaticResource PageSubtitleTextStyle}"
                            Text="本地优先 · 电子元器件库存与同步工作区" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="8">
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="{Binding ShellSyncSummary}" />
                        <Button
                            x:Uid="MainWindowSyncNowButton"
                            HorizontalAlignment="Right"
                            Click="OnSyncNowClicked"
                            Content="立即同步" />
                    </StackPanel>
                </Grid>
            </NavigationView.Header>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="InventoryItem" x:Uid="MainWindowInventoryItem" Content="库存" Tag="Inventory">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MovementsItem" x:Uid="MainWindowMovementsItem" Content="出入库" Tag="Movements">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Sort" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="OverviewItem" x:Uid="MainWindowOverviewItem" Content="概览" Tag="Overview">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsItem" x:Uid="MainWindowSettingsItem" Content="设置" Tag="Settings">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="RootFrame" />
        </NavigationView>
    </Grid>
</Window>
