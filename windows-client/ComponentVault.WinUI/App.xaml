<Application
    x:Class="ComponentVault.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <Color x:Key="VaultBackgroundColor">#FFF4F7FA</Color>
        <Color x:Key="VaultSurfaceColor">#FFFFFFFF</Color>
        <Color x:Key="VaultBorderColor">#FFD8E2E8</Color>
        <Color x:Key="VaultAccentColor">#FF0F766E</Color>
        <Color x:Key="VaultAccentSoftColor">#FFE5F4F1</Color>
        <Color x:Key="VaultWarningColor">#FFB25A00</Color>
        <Color x:Key="VaultWarningSoftColor">#FFFFE2C7</Color>

        <SolidColorBrush x:Key="VaultBackgroundBrush" Color="{StaticResource VaultBackgroundColor}" />
        <SolidColorBrush x:Key="VaultSurfaceBrush" Color="{StaticResource VaultSurfaceColor}" />
        <SolidColorBrush x:Key="VaultBorderBrush" Color="{StaticResource VaultBorderColor}" />
        <SolidColorBrush x:Key="VaultAccentBrush" Color="{StaticResource VaultAccentColor}" />
        <SolidColorBrush x:Key="VaultAccentSoftBrush" Color="{StaticResource VaultAccentSoftColor}" />
        <SolidColorBrush x:Key="VaultWarningBrush" Color="{StaticResource VaultWarningColor}" />
        <SolidColorBrush x:Key="VaultWarningSoftBrush" Color="{StaticResource VaultWarningSoftColor}" />

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="Background" Value="{StaticResource VaultSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource VaultBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Resources>
</Application>

