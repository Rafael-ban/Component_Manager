<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ComponentVault.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <Version>0.5.3</Version>
    <AssemblyVersion>0.5.3.0</AssemblyVersion>
    <FileVersion>0.5.3.0</FileVersion>
    <InformationalVersion>0.5.3</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
  </ItemGroup>

  <!--
    The WinUI compiler copies generated XBF files to OutputPath, but the .NET
    publish pipeline does not include those files for an unpackaged app.
    Publish them at their application-relative paths so ms-appx XAML URIs can
    resolve in the portable distribution.
  -->
  <Target Name="IncludeWinUiXamlInPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="ComputeProcessXamlFiles"
          Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_WinUiCompiledXaml Include="@(ProcessedXamlFiles->'%(FullPath)')" />
    </ItemGroup>

    <AssignTargetPath Files="@(_WinUiCompiledXaml)" RootFolder="$(OutputPath)\">
      <Output TaskParameter="AssignedFiles" ItemName="_WinUiXamlFilesToPublish" />
    </AssignTargetPath>

    <Error Condition="'@(_WinUiXamlFilesToPublish)' == ''"
           Text="The WinUI compiler produced no XAML resources for the portable publish." />

    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_WinUiXamlFilesToPublish)" />
      <ResolvedFileToPublish Include="@(_WinUiXamlFilesToPublish)">
        <RelativePath>%(_WinUiXamlFilesToPublish.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
