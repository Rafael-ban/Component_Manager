<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ComponentVault.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishProfile>win-x64.pubxml</PublishProfile>
    <Version>0.7.0</Version>
    <AssemblyVersion>0.7.0.0</AssemblyVersion>
    <FileVersion>0.7.0.0</FileVersion>
    <InformationalVersion>0.7.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
  </ItemGroup>

  <!--
    The WinUI compiler places application XBF files in OutputPath, but the .NET
    publish pipeline does not include them for an unpackaged app. Keep their
    application-relative paths so ms-appx URIs resolve in the portable app.
  -->
  <Target Name="IncludeWinUiXamlInPublish"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="ComputeProcessXamlFiles"
          Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_WinUiCompiledXamlCandidate Include="$(OutputPath)**\*.xbf"
                                   Exclude="$(OutputPath)publish\**\*.xbf;$(PublishDir)**\*.xbf" />
      <_WinUiCompiledXaml Include="@(_WinUiCompiledXamlCandidate->'%(FullPath)')" />
    </ItemGroup>

    <AssignTargetPath Files="@(_WinUiCompiledXaml)" RootFolder="$(OutputPath)\">
      <Output TaskParameter="AssignedFiles" ItemName="_WinUiXamlFilesToPublish" />
    </AssignTargetPath>

    <Error Condition="'@(_WinUiXamlFilesToPublish)' == ''"
           Text="The WinUI compiler produced no XAML resources for the portable publish." />

    <ItemGroup>
      <ResolvedFileToPublish Remove="@(_WinUiXamlFilesToPublish)" />
      <ResolvedFileToPublish Include="@(_WinUiXamlFilesToPublish)">
        <RelativePath>%(_WinUiXamlFilesToPublish.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    MRT Core generates the app PRI for unpackaged builds, including the merged
    Windows App SDK resource maps, but its targets do not add that PRI to the
    .NET publish list. This mirrors the MSIX target's publish wiring.
  -->
  <Target Name="IncludeProjectPriInPortablePublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)"
          Condition="'$(WindowsPackageType)' == 'None'">
    <Error Condition="'$(CopyBuildOutputToPublishDirectory)' == 'true' and !Exists('$(ProjectPriFullPath)')"
           Text="The MRT Core project PRI was not generated for the portable publish." />

    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)"
                             Condition="'$(CopyBuildOutputToPublishDirectory)' == 'true' and Exists('$(ProjectPriFullPath)')">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
