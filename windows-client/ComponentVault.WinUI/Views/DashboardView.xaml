<Page
    x:Class="ComponentVault.WinUI.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:ComponentVault.WinUI.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=design:DesignMainViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="库存概览" />
            <TextBlock Margin="0,6,0,20" Style="{StaticResource PageSubtitleTextStyle}" Text="本地优先的桌面库存总览，集中展示库存规模、低库存风险和同步状态。" />

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="元器件" />
                        <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding Dashboard.ComponentCount}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="现存数量" />
                        <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding Dashboard.TotalUnits}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Margin="16,0,0,0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="低库存" />
                        <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding Dashboard.LowStockCount}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Margin="16,0,0,0" Style="{StaticResource MetricCardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="变动记录" />
                        <TextBlock FontSize="28" FontWeight="Bold" Text="{Binding Dashboard.MovementCount}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="低库存关注列表" />
                        <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="已低于或等于最低库存阈值的元器件。" TextWrapping="Wrap" />
                        <ListView ItemsSource="{Binding LowStockComponents}">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="{Binding Sku}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            FontWeight="SemiBold"
                                            Text="{Binding Quantity}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Margin="16,0,0,0" Style="{StaticResource InsetPanelStyle}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="同步状态" />
                        <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="查看当前桌面端连接配置、最近同步结果和最近同步时间。" TextWrapping="Wrap" />
                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Informational"
                            Title="服务端地址"
                            Message="{Binding SyncEndpointDisplay}" />
                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Success"
                            Title="最近同步结果"
                            Message="{Binding SyncConfiguration.LastSyncMessage}" />
                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Success"
                            Title="最近同步时间"
                            Message="{Binding SyncConfiguration.LastSyncedAt}" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
