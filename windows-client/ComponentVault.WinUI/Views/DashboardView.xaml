<Page
    x:Class="ComponentVault.WinUI.Views.DashboardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:ComponentVault.WinUI.Design"
    xmlns:models="using:ComponentVault.WinUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=design:DesignMainViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel
            Padding="24"
            Spacing="16">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="WideLayout" />
                    <VisualState x:Name="CompactLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="MetricColumn2.Width" Value="*" />
                            <Setter Target="MetricColumn3.Width" Value="0" />
                            <Setter Target="MetricColumn4.Width" Value="0" />
                            <Setter Target="LowStockMetric.(Grid.Row)" Value="1" />
                            <Setter Target="LowStockMetric.(Grid.Column)" Value="0" />
                            <Setter Target="MovementMetric.(Grid.Row)" Value="1" />
                            <Setter Target="MovementMetric.(Grid.Column)" Value="1" />
                            <Setter Target="ActivityColumn.Width" Value="0" />
                            <Setter Target="RecentActivityCard.(Grid.Row)" Value="1" />
                            <Setter Target="RecentActivityCard.(Grid.Column)" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="ExpandedLayout">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Spacing="4">
                    <TextBlock
                        x:Uid="DashboardViewPageTitle"
                        Style="{StaticResource PageTitleTextStyle}"
                        Text="概览" />
                    <TextBlock
                        x:Uid="DashboardViewPageSubtitle"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="库存规模、风险和最近作业一目了然。" />
                </StackPanel>
                <Button
                    x:Uid="DashboardOpenInventoryButton"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Click="OnOpenInventoryClicked"
                    Content="打开库存"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
            <Grid x:Name="MetricGrid" ColumnSpacing="12" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="MetricColumn2"
                        Width="*" />
                    <ColumnDefinition x:Name="MetricColumn3"
                        Width="*" />
                    <ColumnDefinition x:Name="MetricColumn4"
                        Width="*" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Style="{StaticResource MetricCardStyle}">
                    <StackPanel
                        Spacing="3">
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="元器件" />
                        <TextBlock
                            Style="{StaticResource MetricValueTextStyle}"
                            Text="{Binding Dashboard.ComponentCount}" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="1"
                    Style="{StaticResource MetricCardStyle}">
                    <StackPanel
                        Spacing="3">
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="库存总量" />
                        <TextBlock
                            Style="{StaticResource MetricValueTextStyle}"
                            Text="{Binding Dashboard.TotalUnits}" />
                    </StackPanel>
                </Border>
                <Border x:Name="LowStockMetric"
                    Grid.Column="2"
                    Style="{StaticResource MetricCardStyle}">
                    <StackPanel
                        Spacing="3">
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="低库存" />
                        <TextBlock
                            Style="{StaticResource MetricValueTextStyle}"
                            Foreground="{StaticResource VaultWarningBrush}"
                            Text="{Binding Dashboard.LowStockCount}" />
                    </StackPanel>
                </Border>
                <Border x:Name="MovementMetric"
                    Grid.Column="3"
                    Style="{StaticResource MetricCardStyle}">
                    <StackPanel
                        Spacing="3">
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="变动记录" />
                        <TextBlock
                            Style="{StaticResource MetricValueTextStyle}"
                            Text="{Binding Dashboard.MovementCount}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Grid ColumnSpacing="16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ActivityColumn"
                        Width="*" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel
                        Spacing="12">
                        <Grid>
                            <TextBlock
                                Style="{StaticResource SectionTitleTextStyle}"
                                Text="低库存关注" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="OnOpenInventoryClicked"
                                Content="查看全部" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{Binding OverviewLowStockSummary}"
                            TextWrapping="Wrap" />
                        <ItemsControl
                            ItemsSource="{Binding OverviewLowStockComponents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    x:DataType="models:ComponentRecord">
                                    <Grid
                                        Margin="0,6"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding Sku}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding Quantity}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding Location}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border x:Name="RecentActivityCard"
                    Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel
                        Spacing="12">
                        <Grid>
                            <TextBlock
                                Style="{StaticResource SectionTitleTextStyle}"
                                Text="最近作业" />
                            <Button
                                HorizontalAlignment="Right"
                                Click="OnOpenMovementsClicked"
                                Content="查看台账" />
                        </Grid>
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{Binding OverviewRecentMovementSummary}"
                            TextWrapping="Wrap" />
                        <ItemsControl
                            ItemsSource="{Binding OverviewRecentMovements}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate
                                    x:DataType="models:StockMovementRecord">
                                    <Grid
                                        Margin="0,6"
                                        ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding ComponentName}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding Reason}" />
                                        </StackPanel>
                                        <StackPanel
                                            Grid.Column="1"
                                            HorizontalAlignment="Right">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Text="{Binding QuantityLabel}" />
                                            <TextBlock
                                                Style="{StaticResource CaptionTextStyle}"
                                                Text="{Binding MovementTypeLabel}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
            <Border
                Style="{StaticResource InsetPanelStyle}">
                <Grid
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        Spacing="3">
                        <TextBlock
                            FontWeight="SemiBold"
                            Text="同步状态" />
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="{Binding OverviewSyncSummary}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Uid="DashboardOpenSettingsButton"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Click="OnOpenSettingsClicked"
                        Content="同步设置" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
