<Page x:Class="ComponentVault.WinUI.Views.BomView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="24" RowSpacing="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="5">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="项目 BOM 扣料"/>
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="导入项目 BOM，核对物料与需求量，然后批量出库。库存不足时整批暂停。"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="ProjectNameBox" Header="项目名称" PlaceholderText="例如 主控板 A" TextChanged="OnInputsChanged"/>
                <NumberBox x:Name="BatchQuantityBox" Grid.Column="1" Header="生产批数" Minimum="1" Value="1" SpinButtonPlacementMode="Compact" ValueChanged="OnBatchQuantityChanged"/>
                <Button Grid.Column="2" VerticalAlignment="Bottom" Click="OnChooseFileClicked" Content="选择 BOM 文件"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid RowSpacing="10"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock x:Name="SummaryText" Text="尚未选择文件。" TextWrapping="Wrap"/>
                <ListView x:Name="PreviewList" Grid.Row="1"/>
            </Grid>
        </Border>
        <StackPanel Grid.Row="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
            <Button Click="OnNewBatchClicked" Content="新建生产批次"/>
            <Button x:Name="ResolveButton" Click="OnResolveClicked" Content="解决候选匹配" IsEnabled="False"/>
            <Button x:Name="ConfirmButton" Click="OnConfirmClicked" Content="确认并扣减库存" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Page>
