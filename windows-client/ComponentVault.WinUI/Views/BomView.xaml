<Page
    x:Class="ComponentVault.WinUI.Views.BomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        Padding="24"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                Spacing="4">
                <TextBlock
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="项目 BOM" />
                <TextBlock
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="导入清单、核对匹配，再一次性确认扣料。库存不足时不会执行部分扣减。" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                Click="OnNewBatchClicked"
                Content="新建批次" />
        </Grid>
        <Border
            Grid.Row="1"
            Style="{StaticResource CardBorderStyle}">
            <Grid
                ColumnSpacing="16"
                RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="2*" />
                    <ColumnDefinition
                        Width="140" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="{StaticResource VaultAccentBrush}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="1" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="项目与文件" />
                </StackPanel>
                <TextBox
                    x:Name="ProjectNameBox"
                    Grid.Row="1"
                    Header="项目名称"
                    PlaceholderText="例如：主控板 A"
                    TextChanged="OnInputsChanged" />
                <NumberBox
                    x:Name="BatchQuantityBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Header="生产批数"
                    Minimum="1"
                    Value="1"
                    SpinButtonPlacementMode="Compact"
                    ValueChanged="OnBatchQuantityChanged" />
                <Button
                    Grid.Row="1"
                    Grid.Column="2"
                    MinWidth="132"
                    VerticalAlignment="Bottom"
                    Click="OnChooseFileClicked"
                    Content="选择 BOM 文件"
                    Style="{StaticResource AccentButtonStyle}" />
            </Grid>
        </Border>
        <Border
            Grid.Row="2"
            Style="{StaticResource CardBorderStyle}">
            <Grid
                RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="8">
                    <Border
                        Width="24"
                        Height="24"
                        CornerRadius="12"
                        Background="{StaticResource VaultAccentBrush}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Text="2" />
                    </Border>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="预览与匹配" />
                </StackPanel>
                <TextBlock
                    x:Name="SummaryText"
                    Grid.Row="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="尚未选择文件。"
                    TextWrapping="Wrap" />
                <ListView
                    x:Name="PreviewList"
                    Grid.Row="2" />
            </Grid>
        </Border>
        <Grid
            Grid.Row="3">
            <StackPanel
                Orientation="Horizontal"
                Spacing="8">
                <Border
                    Width="24"
                    Height="24"
                    CornerRadius="12"
                    Background="{StaticResource VaultAccentBrush}">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Text="3" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="确认扣料" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="ResolveButton"
                    Click="OnResolveClicked"
                    Content="解决候选匹配"
                    IsEnabled="False" />
                <Button
                    x:Name="ConfirmButton"
                    Click="OnConfirmClicked"
                    Content="确认并扣减库存"
                    IsEnabled="False"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>