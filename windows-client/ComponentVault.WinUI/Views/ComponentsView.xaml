<Page
    x:Class="ComponentVault.WinUI.Views.ComponentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:ComponentVault.WinUI.Design"
    xmlns:models="using:ComponentVault.WinUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=design:DesignMainViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="元器件管理" />
            <TextBlock Margin="0,6,0,20" Style="{StaticResource PageSubtitleTextStyle}" Text="按桌面端更高的信息密度浏览库存，并快速查看选中元器件的关键详情。" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                        <AppBarButton Click="OnAddComponentClicked" Icon="Add" Label="新增元器件" />
                        <AppBarButton Click="OnEditComponentClicked" Icon="Edit" Label="编辑当前项" />
                        <AppBarButton Click="OnDeleteComponentClicked" Icon="Delete" Label="软删除" />
                    </CommandBar>

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <AutoSuggestBox
                            x:Name="ComponentSearchBox"
                            PlaceholderText="搜索 SKU、名称、分类或库位"
                            QueryIcon="Find"
                            TextChanged="OnSearchTextChanged" />

                        <ToggleSwitch
                            x:Name="LowStockOnlyToggle"
                            Grid.Column="1"
                            Header="仅看低库存"
                            Toggled="OnLowStockOnlyToggled" />
                    </Grid>

                    <TextBlock
                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                        Text="{Binding ComponentInventorySummary}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                        Text="{Binding StatusMessage}"
                        TextWrapping="Wrap" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="360" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="12">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="库存列表" />
                            <TextBlock
                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                Text="从列表中选择一项，即可查看封装、库位、库存风险和同步相关信息。"
                                TextWrapping="Wrap" />

                            <ListView
                                x:Name="ComponentsListView"
                                ItemsSource="{Binding Components}"
                                SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                                SelectionChanged="OnComponentSelectionChanged"
                                SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ComponentRecord">
                                        <Border
                                            Margin="0,0,0,10"
                                            Padding="16"
                                            Background="{StaticResource VaultSurfaceBrush}"
                                            BorderBrush="{StaticResource VaultBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16">
                                            <StackPanel Spacing="10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="{Binding Sku}" />
                                                    </StackPanel>
                                                    <Border
                                                        Grid.Column="1"
                                                        Padding="10,6"
                                                        Background="{StaticResource VaultAccentSoftBrush}"
                                                        CornerRadius="999">
                                                        <TextBlock Foreground="{StaticResource VaultAccentBrush}" Text="{Binding Quantity}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="{Binding Description}" TextWrapping="Wrap" />
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <Border Padding="10,6" Background="{StaticResource ControlFillColorSecondaryBrush}" CornerRadius="999">
                                                        <TextBlock Text="{Binding Location}" />
                                                    </Border>
                                                    <Border Padding="10,6" Background="{StaticResource VaultWarningSoftBrush}" CornerRadius="999">
                                                        <TextBlock Foreground="{StaticResource VaultWarningBrush}" Text="{Binding Status}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource InsetPanelStyle}">
                            <StackPanel Spacing="14">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="当前选中" />
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedComponentName}" />
                                <TextBlock
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedComponentSubtitle}"
                                    TextWrapping="Wrap" />

                                <InfoBar
                                    IsOpen="True"
                                    IsClosable="False"
                                    Severity="{Binding SelectedComponentStatusSeverity}"
                                    Title="{Binding SelectedComponentStatusTitle}"
                                    Message="{Binding SelectedComponentStatusMessage}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Padding="14"
                                        Background="{StaticResource VaultSurfaceBrush}"
                                        BorderBrush="{StaticResource VaultBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="库存数量" />
                                            <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding SelectedComponentQuantityText}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Grid.Column="1"
                                        Padding="14"
                                        Background="{StaticResource VaultSurfaceBrush}"
                                        BorderBrush="{StaticResource VaultBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14">
                                        <StackPanel Spacing="4">
                                            <TextBlock Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="最低库存" />
                                            <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding SelectedComponentMinStockText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <StackPanel Spacing="10">
                                    <TextBlock FontWeight="SemiBold" Text="存放与同步信息" />
                                    <Grid ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="库位" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Medium" Text="{Binding SelectedComponentLocation}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="1" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="更新时间" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Medium" Text="{Binding SelectedComponentUpdatedAt}" TextWrapping="Wrap" />

                                        <TextBlock Grid.Row="2" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="说明" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Medium" Text="{Binding SelectedComponentDescription}" TextWrapping="Wrap" />
                                    </Grid>
                                </StackPanel>

                                <TextBlock
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedComponentActionHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
