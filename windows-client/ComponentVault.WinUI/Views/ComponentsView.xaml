<Page
    x:Class="ComponentVault.WinUI.Views.ComponentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:ComponentVault.WinUI.Design"
    xmlns:models="using:ComponentVault.WinUI.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=design:DesignMainViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <Grid Padding="24" RowSpacing="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="6">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="库存工作台" />
            <TextBlock
                Style="{StaticResource PageSubtitleTextStyle}"
                Text="搜索、筛选和连续列表优先；选中任一元器件后，在右侧查看库存、仓位和最近变动摘要。" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="14">
                <CommandBar Background="Transparent" DefaultLabelPosition="Right">
                    <AppBarButton Click="OnAddComponentClicked" Icon="Add" Label="新增元器件" />
                </CommandBar>

                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <AutoSuggestBox
                        x:Name="ComponentSearchBox"
                        Grid.Column="0"
                        PlaceholderText="搜索 SKU、名称、分类或仓位"
                        QueryIcon="Find"
                        Text="{Binding ComponentSearchText, Mode=TwoWay}"
                        TextChanged="OnSearchTextChanged" />

                    <ToggleSwitch
                        x:Name="LowStockOnlyToggle"
                        Grid.Column="1"
                        Header="低库存"
                        IsOn="{Binding ShowLowStockOnly, Mode=TwoWay}"
                        Toggled="OnLowStockOnlyToggled" />

                    <ComboBox
                        Grid.Column="2"
                        Header="分类"
                        ItemsSource="{Binding InventoryCategoryOptions}"
                        SelectedItem="{Binding SelectedComponentCategoryFilter, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Column="3"
                        Header="仓位"
                        ItemsSource="{Binding InventoryLocationOptions}"
                        SelectedItem="{Binding SelectedComponentLocationFilter, Mode=TwoWay}" />

                    <ComboBox
                        Grid.Column="4"
                        Header="排序"
                        ItemsSource="{Binding InventorySortOptions}"
                        SelectedItem="{Binding SelectedComponentSortOption, Mode=TwoWay}" />
                </Grid>

                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                        Text="{Binding InventoryFilterSummary}"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Foreground="{StaticResource TextFillColorSecondaryBrush}"
                        Text="{Binding InventoryWorkspaceSummary}"
                        TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.3*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="4">
                        <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="库存列表" />
                        <TextBlock
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="{Binding ComponentInventorySummary}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Padding="12,10"
                        Background="{StaticResource VaultPanelBrush}"
                        BorderBrush="{StaticResource VaultBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="元器件" />
                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Text="分类 / 封装" />
                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionTextStyle}" Text="仓位" />
                            <TextBlock Grid.Column="3" Style="{StaticResource CaptionTextStyle}" Text="库存" />
                            <TextBlock Grid.Column="4" Style="{StaticResource CaptionTextStyle}" Text="状态" />
                        </Grid>
                    </Border>

                    <ListView
                        x:Name="ComponentsListView"
                        Grid.Row="2"
                        ItemsSource="{Binding Components}"
                        SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                        SelectionChanged="OnComponentSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ComponentRecord">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="12,10"
                                    Background="{StaticResource VaultSurfaceBrush}"
                                    BorderBrush="{StaticResource VaultBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="1.2*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Sku}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Category}" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding PackageName}" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Text="{Binding Location}" />

                                        <StackPanel Grid.Column="3" HorizontalAlignment="Right">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Quantity}" />
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding MinStock}" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="4"
                                            Padding="10,4"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource VaultAccentSoftBrush}"
                                            CornerRadius="999">
                                            <TextBlock Foreground="{StaticResource VaultAccentBrush}" Text="{Binding Status}" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource InsetPanelStyle}">
                <ScrollViewer>
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="详情检查器" />
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="{Binding SelectedComponentName}" />
                                <TextBlock
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedComponentSubtitle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Click="OnEditComponentClicked"
                                    IsEnabled="{Binding CanEditSelectedComponent}"
                                    Content="编辑" />
                                <Button
                                    Click="OnDeleteComponentClicked"
                                    IsEnabled="{Binding CanDeleteSelectedComponent}"
                                    Content="软删除" />
                            </StackPanel>
                        </Grid>

                        <InfoBar
                            IsOpen="True"
                            IsClosable="False"
                            Severity="{Binding SelectedComponentStatusSeverity}"
                            Title="{Binding SelectedComponentStatusTitle}"
                            Message="{Binding SelectedComponentStatusMessage}" />

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="基本信息" />
                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Style="{StaticResource CaptionTextStyle}" Text="SKU" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedComponentSubtitle}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Style="{StaticResource CaptionTextStyle}" Text="仓位" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedComponentLocation}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2" Style="{StaticResource CaptionTextStyle}" Text="更新" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedComponentUpdatedAt}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="库存状态" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="当前库存" />
                                            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding SelectedComponentQuantityText}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="最低库存" />
                                            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding SelectedComponentMinStockText}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                                        <StackPanel Spacing="4">
                                            <TextBlock Style="{StaticResource CaptionTextStyle}" Text="安全余量" />
                                            <TextBlock Style="{StaticResource MetricValueTextStyle}" Text="{Binding SelectedComponentStockDeltaText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="描述 / 备注" />
                                <TextBlock Text="{Binding SelectedComponentDescription}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="最近变动摘要" />
                                <TextBlock
                                    Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                    Text="{Binding SelectedComponentMovementSummary}"
                                    TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{Binding SelectedComponentRecentMovements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:StockMovementRecord">
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="12"
                                                Background="{StaticResource VaultPanelBrush}"
                                                BorderBrush="{StaticResource VaultBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Padding="10,4"
                                                        Background="{StaticResource VaultAccentSoftBrush}"
                                                        CornerRadius="999">
                                                        <TextBlock
                                                            Foreground="{StaticResource VaultAccentBrush}"
                                                            Text="{Binding MovementTypeLabel}" />
                                                    </Border>

                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Reason}" />
                                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Note}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding QuantityLabel}" />
                                                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding HappenedAt}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedComponentActionHint}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
