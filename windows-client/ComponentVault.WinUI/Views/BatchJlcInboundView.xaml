<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ComponentVault.WinUI.Views" x:Class="ComponentVault.WinUI.Views.BatchJlcInboundView" Unloaded="OnUnloaded">
    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="批量嘉立创入库"/>
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="扫码枪回车逐条收集，或粘贴每行一个包装 QR；采集阶段不会联网。"/>
            </StackPanel>
            <Button x:Name="BackButton" HorizontalAlignment="Right" Click="OnBack" Content="返回库存"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
            <StackPanel Spacing="10">
                <TextBox x:Name="CaptureBox" Header="扫码或粘贴" PlaceholderText="扫码后按回车；也可粘贴多行" AcceptsReturn="True" KeyDown="OnCaptureKeyDown"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CollectButton" Click="OnCollect" Content="收集文本"/>
                    <Button x:Name="ParseButton" Click="OnParse" Content="解析未处理包装" Style="{StaticResource AccentButtonStyle}"/>
                    <Button Click="OnCancelLookup" Content="取消查询"/>
                    <Button x:Name="ClearButton" Click="OnClearDraft" Content="清空草稿"/>
                </StackPanel>
                <TextBlock x:Name="CountText" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
        <Pivot Grid.Row="2">
            <PivotItem Header="入库核对">
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="DefaultLocationBox" Width="180" DisplayMemberPath="Id" PlaceholderText="统一默认库位"/>
                            <Button x:Name="ApplyLocationButton" Click="OnApplyDefaultLocation" Content="应用统一库位"/>
                            <Button x:Name="SubmitButton" Click="OnSubmit" Content="确认所选入库" Style="{StaticResource AccentButtonStyle}"/>
                        </StackPanel>
                        <ListView x:Name="ReadyList" Grid.Row="1">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:BatchInboundEditableRow">
                                    <StackPanel Margin="0,6" Spacing="4">
                                        <CheckBox Content="{x:Bind Summary}" IsChecked="{x:Bind Selected,Mode=TwoWay}" Click="OnDraftFieldChanged"/>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <NumberBox Header="数量" Value="{x:Bind QuantityInput,Mode=TwoWay}" Minimum="1" LostFocus="OnDraftFieldLostFocus"/>
                                            <ComboBox Grid.Column="1" Header="库位" ItemsSource="{x:Bind LocationIds}" SelectedItem="{x:Bind LocationId,Mode=TwoWay}" LostFocus="OnDraftFieldLostFocus"/>
                                            <TextBox Grid.Column="2" Header="名称" Text="{x:Bind Name,Mode=TwoWay}" LostFocus="OnDraftFieldLostFocus"/>
                                            <TextBox Grid.Column="3" Header="封装" Text="{x:Bind PackageName,Mode=TwoWay}" LostFocus="OnDraftFieldLostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>
            <PivotItem Header="待处理">
                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="解析、数量或查询失败的包装保留在本页。补齐 C 号、正整数数量、库位、名称、分类和封装后可标记为就绪。" TextWrapping="Wrap"/>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="RetryButton" Click="OnRetryPending" Content="重试或标记所选"/>
                            <Button x:Name="RemoveButton" Click="OnRemovePending" Content="移除所选"/>
                        </StackPanel>
                        <ListView x:Name="PendingList" Grid.Row="2" SelectionMode="Multiple">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:BatchInboundEditableRow">
                                    <StackPanel Margin="0,6" Spacing="4">
                                        <TextBlock Text="{x:Bind Reason}" Foreground="DarkOrange" TextWrapping="Wrap"/>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Header="C 编号" Text="{x:Bind Sku,Mode=TwoWay}" LostFocus="OnDraftFieldLostFocus"/>
                                            <NumberBox Grid.Column="1" Header="数量" Value="{x:Bind QuantityInput,Mode=TwoWay}" Minimum="1" LostFocus="OnDraftFieldLostFocus"/>
                                            <ComboBox Grid.Column="2" Header="库位" ItemsSource="{x:Bind LocationIds}" SelectedItem="{x:Bind LocationId,Mode=TwoWay}" LostFocus="OnDraftFieldLostFocus"/>
                                        </Grid>
                                        <Grid ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Header="名称" Text="{x:Bind Name,Mode=TwoWay}" LostFocus="OnDraftFieldLostFocus"/>
                                            <TextBox Grid.Column="1" Header="分类" Text="{x:Bind Category,Mode=TwoWay}" LostFocus="OnDraftFieldLostFocus"/>
                                            <TextBox Grid.Column="2" Header="封装" Text="{x:Bind PackageName,Mode=TwoWay}" LostFocus="OnDraftFieldLostFocus"/>
                                        </Grid>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
