<Page
    x:Class="ComponentVault.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:ComponentVault.WinUI.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=design:DesignMainViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d"
    Unloaded="OnPageUnloaded">
    <ScrollViewer>
        <StackPanel
            Padding="24"
            Spacing="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Spacing="4">
                    <TextBlock
                        x:Uid="SettingsViewPageTitle"
                        Style="{StaticResource PageTitleTextStyle}"
                        Text="设置" />
                    <TextBlock
                        x:Uid="SettingsViewPageSubtitle"
                        Style="{StaticResource PageSubtitleTextStyle}"
                        Text="管理同步连接、应用偏好与版本信息。" />
                </StackPanel>
                <CommandBar
                    Grid.Column="1"
                    Background="Transparent"
                    DefaultLabelPosition="Right">
                    <AppBarButton
                        x:Uid="SettingsTestButton"
                        Click="OnTestConnectionClicked"
                        Icon="World"
                        IsEnabled="{Binding CanRunSyncActions}"
                        Label="测试连接" />
                    <AppBarButton
                        x:Uid="SettingsSaveButton"
                        Click="OnSaveSettingsClicked"
                        Icon="Save"
                        IsEnabled="{Binding CanRunSyncActions}"
                        Label="保存设置" />
                </CommandBar>
            </Grid>
            <Grid
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="1.55*" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    Spacing="16">
                    <Border
                        Style="{StaticResource CardBorderStyle}">
                        <StackPanel
                            Spacing="14">
                            <TextBlock
                                Style="{StaticResource SectionTitleTextStyle}"
                                Text="服务器连接" />
                            <TextBox
                                x:Uid="SettingsServerUrlTextBox"
                                x:Name="ServerUrlTextBox"
                                Header="优先服务器地址（局域网）"
                                PlaceholderText="http://localhost:8787" />
                            <TextBox
                                x:Name="FallbackServerUrlTextBox"
                                Header="备用服务器地址（外网，可选）"
                                PlaceholderText="https://sync.example.com" />
                            <PasswordBox
                                x:Name="ApiTokenBox"
                                Header="API 令牌"
                                PasswordChanged="OnApiTokenPasswordChanged" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="API Token 是部署者设置的 API_TOKEN。部署者可在 Docker 管理面板中打开本应用的 API 容器，查看环境变量 API_TOKEN；也可查看部署目录的 .env。它不是 GPG_KEY 或 DOCKERHUB_TOKEN，也不需要去 GitHub 申请。非部署者请联系管理员。"
                                TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="ToggleApiTokenButton"
                                    Click="OnToggleApiTokenClicked"
                                    Content="显示令牌" />
                                <Button
                                    x:Name="CopyApiTokenButton"
                                    Click="OnCopyApiTokenClicked"
                                    Content="复制令牌"
                                    IsEnabled="False" />
                                <TextBlock
                                    x:Name="ApiTokenCopyStatusText"
                                    Style="{StaticResource CaptionTextStyle}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AutoSyncToggle"
                                Header="启用自动同步"
                                IsOn="False" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="写入始终先保存到本地 SQLite。每轮同步先探测优先地址；仅 DNS、连接或超时失败时尝试备用地址。选定后本轮 push/pull 固定使用同一地址，写入失败不会换址重放。两个地址必须连接同一服务端和数据库。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border
                        Style="{StaticResource CardBorderStyle}">
                        <StackPanel
                            Spacing="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    Text="同步状态" />
                                <Button
                                    x:Uid="SettingsSyncButton"
                                    Grid.Column="1"
                                    Click="OnSyncNowClicked"
                                    Content="立即同步"
                                    IsEnabled="{Binding CanRunSyncActions}"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="{Binding SyncRiskSeverity}"
                                Title="{Binding SyncRiskTitle}"
                                Message="{Binding SyncRiskMessage}" />
                            <Grid
                                ColumnSpacing="12"
                                RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="88" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="设备 ID" />
                                <TextBox
                                    x:Name="DeviceIdTextBox"
                                    Grid.Column="1"
                                    IsReadOnly="True" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="最近同步" />
                                <TextBox
                                    x:Name="LastSyncedTextBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    IsReadOnly="True" />
                                <TextBlock
                                    Grid.Row="2"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="最近结果" />
                                <TextBox
                                    x:Name="LastResultTextBox"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    IsReadOnly="True"
                                    TextWrapping="Wrap" />
                            </Grid>
                            <Grid
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="Auto" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing
                                    Width="20"
                                    Height="20"
                                    IsActive="{Binding IsBusy}" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="{Binding SyncActionHint}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    Spacing="16">
                    <Border
                        Style="{StaticResource CardBorderStyle}">
                        <StackPanel
                            Spacing="10">
                            <TextBlock
                                Style="{StaticResource SectionTitleTextStyle}"
                                Text="外观" />
                            <Grid
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="跟随 Windows" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="自动适配系统的浅色、高对比度与缩放设置。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <FontIcon
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Glyph=""
                                    Foreground="{StaticResource VaultAccentBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border
                        Style="{StaticResource CardBorderStyle}">
                        <StackPanel
                            Spacing="10">
                            <TextBlock
                                Style="{StaticResource SectionTitleTextStyle}"
                                Text="数据导入" />
                            <TextBlock
                                Text="旧版 component-hub 数据迁移入口位于“库存”页的导入操作中。"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="导入前会预览来源与记录数量；取消操作不会写入数据。"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border
                        Style="{StaticResource CardBorderStyle}">
                        <StackPanel
                            Spacing="12">
                            <Grid
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource SectionTitleTextStyle}"
                                        Text="关于" />
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="Component Vault" />
                                    <TextBlock
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="本地优先的电子元器件库存与 BOM 工具" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right">
                                    <TextBlock
                                        Style="{StaticResource CaptionTextStyle}"
                                        Text="当前版本" />
                                    <TextBlock
                                        x:Name="CurrentVersionText"
                                        FontSize="18"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                            <Grid
                                ColumnSpacing="12"
                                RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="72" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition
                                        Height="Auto" />
                                    <RowDefinition
                                        Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="作者" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="Rafael-Ikaros" />
                                <TextBlock
                                    Grid.Row="1"
                                    Style="{StaticResource CaptionTextStyle}"
                                    Text="许可证" />
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="GNU GPLv3" />
                            </Grid>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="4">
                                <HyperlinkButton
                                    Padding="0,4"
                                    NavigateUri="https://github.com/Rafael-ban/Component_Manager"
                                    Content="GitHub 项目" />
                                <HyperlinkButton
                                    NavigateUri="https://github.com/Rafael-ban/Component_Manager/blob/master/LICENSE.txt"
                                    Content="查看许可证" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Border
                Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="库存备份与迁入" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="导出 component-vault Excel 备份，或预览后仅新增迁入本项目/LCSC_android_erp schema1 工作簿。不会导出同步凭据。" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnExportInventoryClicked" Content="导出 Excel 备份" />
                        <Button Click="OnImportInventoryClicked" Content="预览并迁入 Excel" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="标签打印数据导出" />
                    <TextBlock Style="{StaticResource CaptionTextStyle}" Text="每个未删除元器件一行，生成供第三方标签软件使用的 Excel；不会改变备份恢复格式。" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <CheckBox x:Name="LabelNameColumn" Grid.Row="0" Grid.Column="0" Content="名称" IsChecked="True" />
                        <CheckBox x:Name="LabelSkuColumn" Grid.Row="0" Grid.Column="1" Content="SKU" IsChecked="True" />
                        <CheckBox x:Name="LabelModelColumn" Grid.Row="0" Grid.Column="2" Content="型号" />
                        <CheckBox x:Name="LabelPackageColumn" Grid.Row="1" Grid.Column="0" Content="封装" />
                        <CheckBox x:Name="LabelCategoryColumn" Grid.Row="1" Grid.Column="1" Content="分类" />
                        <CheckBox x:Name="LabelLocationColumn" Grid.Row="1" Grid.Column="2" Content="库位" />
                        <CheckBox x:Name="LabelQuantityColumn" Grid.Row="2" Grid.Column="0" Content="当前数量" />
                        <CheckBox x:Name="LabelLongQrColumn" Grid.Row="2" Grid.Column="1" Content="长二维码文本" IsChecked="True" />
                        <CheckBox x:Name="LabelShortQrColumn" Grid.Row="2" Grid.Column="2" Content="短二维码文本" IsChecked="True" />
                    </Grid>
                    <Button HorizontalAlignment="Left" Click="OnExportLabelWorkbookClicked" Content="导出标签打印 Excel" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="反馈与诊断" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="公开内容" Message="GitHub Issue 是公开内容。提交前请检查并删除不希望公开的信息；应用不会保存 GitHub 凭据或自动提交。" />
                    <TextBox x:Name="FeedbackTitleBox" Header="标题" PlaceholderText="简要描述问题" />
                    <TextBox x:Name="FeedbackReproductionBox" Header="复现步骤" AcceptsReturn="True" MinHeight="88" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="FeedbackExpectedBox" Header="期待结果" AcceptsReturn="True" MinHeight="88" TextWrapping="Wrap" />
                        <TextBox x:Name="FeedbackActualBox" Grid.Column="1" Header="实际结果" AcceptsReturn="True" MinHeight="88" TextWrapping="Wrap" />
                    </Grid>
                    <ToggleSwitch x:Name="FeedbackDiagnosticsToggle" Header="附加应用诊断" OffContent="默认关闭" OnContent="已附加" Toggled="OnFeedbackDiagnosticsToggled" />
                    <TextBox x:Name="FeedbackDiagnosticsPreviewBox" Header="诊断预览（可编辑或删除）" AcceptsReturn="True" MinHeight="120" MaxHeight="280" TextWrapping="NoWrap" IsEnabled="False" />
                    <TextBlock x:Name="FeedbackStatusText" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Click="OnCopyFeedbackClicked" Content="复制完整报告" />
                        <Button Click="OnExportFeedbackClicked" Content="导出 TXT" />
                        <Button Click="OnOpenFeedbackClicked" Content="前往 GitHub 提交" Style="{StaticResource AccentButtonStyle}" />
                        <Button Click="OnClearDiagnosticsClicked" Content="清除诊断" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border
                Style="{StaticResource CardBorderStyle}">
                <StackPanel
                    Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Spacing="3">
                            <TextBlock
                                Style="{StaticResource SectionTitleTextStyle}"
                                Text="更新" />
                            <TextBlock
                                Style="{StaticResource CaptionTextStyle}"
                                Text="手动读取公开 GitHub Release；不会发送同步令牌。" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="8">
                            <ProgressRing
                                x:Name="UpdateProgressRing"
                                Width="20"
                                Height="20"
                                IsActive="False" />
                            <Button
                                x:Name="CheckUpdateButton"
                                Click="OnCheckUpdateClicked"
                                Content="检查更新" />
                        </StackPanel>
                    </Grid>
                    <InfoBar
                        x:Name="UpdateInfoBar"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="更新检查"
                        Message="尚未检查。" />
                    <Grid
                        ColumnSpacing="12"
                        RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="88" />
                            <ColumnDefinition
                                Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition
                                Height="Auto" />
                            <RowDefinition
                                Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            Style="{StaticResource CaptionTextStyle}"
                            Text="最新版本" />
                        <TextBlock
                            x:Name="LatestVersionText"
                            Grid.Column="1"
                            Text="尚未检查" />
                        <TextBlock
                            Grid.Row="1"
                            Style="{StaticResource CaptionTextStyle}"
                            Text="发布日期" />
                        <TextBlock
                            x:Name="PublishedAtText"
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="—" />
                    </Grid>
                    <Expander
                        Header="更新日志">
                        <Border
                            Padding="12"
                            Background="{StaticResource VaultPanelBrush}"
                            CornerRadius="8">
                            <ScrollViewer
                                MaxHeight="180">
                                <TextBlock
                                    x:Name="ReleaseNotesText"
                                    Text="检查后显示 Release 正文。"
                                    TextWrapping="Wrap"
                                    IsTextSelectionEnabled="True" />
                            </ScrollViewer>
                        </Border>
                    </Expander>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="DownloadPortableButton"
                            Click="OnDownloadPortableClicked"
                            Content="下载便携版"
                            IsEnabled="False" />
                        <Button
                            Click="OnOpenReleasesClicked"
                            Content="打开发布页" />
                    </StackPanel>
                    <TextBlock
                        x:Name="UpdateAssetHint"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="应用不会自动下载或替换当前程序。下载后请解压便携版并运行其中的 ComponentVault.WinUI.exe。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
