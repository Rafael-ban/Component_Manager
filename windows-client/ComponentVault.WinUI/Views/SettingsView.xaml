<Page
    x:Class="ComponentVault.WinUI.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:design="using:ComponentVault.WinUI.Design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DataContext="{d:DesignInstance Type=design:DesignMainViewModel, IsDesignTimeCreatable=True}"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="同步设置" />
            <TextBlock Margin="0,6,0,20" Style="{StaticResource PageSubtitleTextStyle}" Text="配置自建服务端地址、共享令牌与自动同步策略，保证桌面端先本地保存再按需上云。" />

            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="360" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="18">
                        <Grid ColumnSpacing="16" RowSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" VerticalAlignment="Center" Text="服务器地址" />
                            <TextBox x:Name="ServerUrlTextBox" Grid.Row="0" Grid.Column="1" PlaceholderText="http://localhost:8787" />

                            <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="API 令牌" />
                            <PasswordBox x:Name="ApiTokenBox" Grid.Row="1" Grid.Column="1" />

                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="设备 ID" />
                            <TextBox x:Name="DeviceIdTextBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" />

                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="最近同步" />
                            <TextBox x:Name="LastSyncedTextBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" />

                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="最近结果" />
                            <TextBox x:Name="LastResultTextBox" Grid.Row="4" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" />
                        </Grid>

                        <ToggleSwitch
                            x:Name="AutoSyncToggle"
                            Header="启用自动同步"
                            IsOn="False" />

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ProgressRing
                                Width="24"
                                Height="24"
                                IsActive="{Binding IsBusy}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                Text="{Binding SyncActionHint}"
                                TextWrapping="Wrap" />
                        </Grid>

                        <TextBlock
                            Foreground="{StaticResource TextFillColorSecondaryBrush}"
                            Text="{Binding StatusMessage}"
                            TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Click="OnSaveSettingsClicked" IsEnabled="{Binding CanRunSyncActions}" Style="{StaticResource AccentButtonStyle}" Content="保存设置" />
                            <Button Click="OnTestConnectionClicked" IsEnabled="{Binding CanRunSyncActions}" Content="测试连接" />
                            <Button Click="OnSyncNowClicked" IsEnabled="{Binding CanRunSyncActions}" Content="立即同步" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Style="{StaticResource InsetPanelStyle}">
                        <StackPanel Spacing="14">
                            <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="同步状态" />
                            <TextBlock
                                Foreground="{StaticResource TextFillColorSecondaryBrush}"
                                Text="这里会根据当前地址和令牌配置，给出可同步性与风险提示。"
                                TextWrapping="Wrap" />

                            <InfoBar
                                IsOpen="True"
                                IsClosable="False"
                                Severity="{Binding SyncRiskSeverity}"
                                Title="{Binding SyncRiskTitle}"
                                Message="{Binding SyncRiskMessage}" />

                            <StackPanel Spacing="10">
                                <TextBlock FontWeight="SemiBold" Text="当前配置值" />
                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="地址" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Medium" Text="{Binding SyncEndpointDisplay}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="1" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="令牌" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Medium" Text="{Binding SyncTokenDisplay}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="2" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="自动同步" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" FontWeight="Medium" Text="{Binding SyncAutoSyncDisplay}" TextWrapping="Wrap" />

                                    <TextBlock Grid.Row="3" Foreground="{StaticResource TextFillColorSecondaryBrush}" Text="设备 ID" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" FontWeight="Medium" Text="{Binding SyncConfiguration.DeviceId}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
